#!/usr/bin/env ruby
# frozen_string_literal: true

# bin/setup — minimal, business-neutral setup for the Config Bundle.
#
# The only baseline setup step is activating the protected-branch git hooks (issue #6 / ADR 0009): on
# a fresh clone the hooks are inactive until core.hooksPath is set, so this must run once. A Host App
# with its own richer bin/setup (e.g. a Rails app's `bundle install` / `db:prepare`) keeps it —
# bin/ace-sync PRESERVES an existing bin/setup on re-sync (like PROJECT.md), so vendoring never
# clobbers the host's version. When adopting the bundle, add `system! "bin/install-git-hooks"` to that
# existing setup script.

require "fileutils"

APP_ROOT = File.expand_path("..", __dir__)

Dir.chdir(APP_ROOT) do
  puts "== Installing git hooks (protected-branch guard) =="
  ok = system("bin/install-git-hooks")
  exit(1) unless ok

  # nadal Customization (issue #87). Every runbook opens with a bare `tn ...` and nothing else in
  # this repo puts it on PATH, so a fresh clone failed at the first command an HC ran. This step is
  # PRINTED, not run: `npm link` writes into a global npm prefix this script does not own, and it
  # must never run from a git worktree, where it would bind the global `tn` to a throwaway checkout.
  # ASCII only, per rules/scripting.md.
  puts
  puts "== Next: put `tn` on your PATH (not done for you) =="
  puts "  npm install"
  puts "  npm link      # from THIS repo root -- never from a git worktree"
  puts "  tn --help     # expect the command banner"
  puts
  puts "Prefer not to install? Run ./bin/tn from the repo root instead, and read every"
  puts "runbook's `tn ...` line as `./bin/tn ...`."
  exit(0)
end
