#!/usr/bin/env ruby
# frozen_string_literal: true

# bin/setup — this repo's own setup entry point.
#
# The one mandatory step is activating the protected-branch git hooks: on a fresh clone the hooks
# are inactive until core.hooksPath is set, so this must run once. This file is nadal's own — a
# seed path deuce's sync skips as already present (config/vendoring-receipt.md records the split),
# so an upstream update never clobbers it.

require "fileutils"

APP_ROOT = File.expand_path("..", __dir__)

Dir.chdir(APP_ROOT) do
  puts "== Installing git hooks (protected-branch guard) =="
  ok = system("bin/install-git-hooks")
  exit(1) unless ok

  # nadal Customization (issue #87). Every runbook opens with a bare `tn ...` and nothing else in
  # this repo puts it on PATH, so a fresh clone failed at the first command an HC ran. This step is
  # PRINTED, not run: `npm link` writes into a global npm prefix this script does not own, and it
  # must never run from a git worktree, where it would bind the global `tn` to a throwaway checkout.
  # ASCII only, a discipline this repo keeps (stated by the ace-era scripting rule, read now at
  # https://github.com/wrburgess/ace/blob/46fdbb89d4e6dd30a63f01d58c0c75d9feb32608/rules/scripting.md).
  puts
  puts "== Next: put `tn` on your PATH (not done for you) =="
  puts "  npm install"
  puts "  npm link      # from THIS repo root -- never from a git worktree"
  puts "  tn --help     # expect the command banner"
  puts
  puts "`npm link` creates the symlink but does NOT change your PATH. If `tn --help` then says"
  puts "`command not found`, npm's global bin directory is not on your PATH -- print it with"
  puts "`npm prefix -g` and add its `bin` subdirectory to your shell profile."
  puts
  puts "Prefer not to install? Run ./bin/tn from the repo root instead, and read every"
  puts "runbook's `tn ...` line as `./bin/tn ...`."
  exit(0)
end
