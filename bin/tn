#!/bin/sh
# Resolve $0 through its symlink chain BEFORE deriving the repo root. `npm link` (and any global
# install) puts this launcher in a bin directory as a symlink, where an unresolved
# `dirname "$0"` names that bin directory rather than this repo — so $DIR pointed at the Node
# installation and the tsx exec below failed with "No such file or directory" (issue #87).
#
# POSIX sh only, a discipline this repo keeps (the ace-era scripting rule that stated it is read at
# https://github.com/wrburgess/ace/blob/46fdbb89d4e6dd30a63f01d58c0c75d9feb32608/rules/scripting.md):
# `readlink -f` would do this in one line but is not POSIX
# (BSD only gained -f in macOS 12.3), and a bundled script may not add a dependency.
#
# EVERY path split here uses parameter expansion rather than `dirname`, so the only external
# command this script runs is `readlink` — and its failure is checked below. An unchecked helper
# that returns nothing does not fail loudly here: it derives a DIFFERENT root, which is a confusing
# "tsx: No such file" where that root is bare and a different checkout's code where it is not.
# Removing the dependency closes that class; checking one call would only have closed one instance.
#
# The loop terminates: the kernel already walked this same chain to exec us, so it is acyclic and
# shorter than the OS symlink limit. A circular chain fails at exec (ELOOP) and never reaches here.

# Sets $dir to the directory component of $1, by parameter expansion only. ONE implementation, used
# at both split sites: when they were written separately, one of them dispatched on the link TARGET's
# shape while splitting SELF, so a slashless target ("ln -s tn launcher") resolved from the caller's
# working directory — the very defect this file exists to prevent, one branch over.
# Assigns rather than echoes: a command substitution would fork, and would strip a trailing newline
# from a path that legally contains one.
dir_of() {
  case "$1" in
    */*)
      dir="${1%/*}"
      [ -n "$dir" ] || dir="/" # a file directly at the root: "/tn" -> "/"
      ;;
    *) dir="." ;; # no slash at all: already relative to the working directory
  esac
}

SELF="$0"
while [ -L "$SELF" ]; do
  # Fail CLOSED when readlink cannot answer. An empty TARGET would otherwise fall through the
  # wildcard arm as a relative target, making SELF "<dir>/" and DIR the PARENT of the real root.
  # Reachable by a link removed or replaced between the test above and this line.
  if ! TARGET="$(readlink "$SELF")" || [ -z "$TARGET" ]; then
    echo "tn: cannot resolve symlink: $SELF" >&2
    exit 1
  fi
  case "$TARGET" in
    # Only an ABSOLUTE target bypasses the link's directory. Every other shape — with a slash or
    # without — is relative to where the LINK lives, never to the working directory.
    /*) SELF="$TARGET" ;;
    *)
      dir_of "$SELF"
      SELF="$dir/$TARGET"
      ;;
  esac
done

dir_of "$SELF"
if ! DIR="$(CDPATH= cd -- "$dir/.." && pwd)"; then
  echo "tn: cannot resolve repo root from: $SELF" >&2
  exit 1
fi
exec "$DIR/node_modules/.bin/tsx" "$DIR/src/cli/main.ts" "$@"
